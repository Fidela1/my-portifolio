// Alternative download function that creates a simple PDF
const handleDownloadCV = () => {
  // Create a simple text CV (temporary)
  const cvContent = `
FIDELA - Web Developer
======================

Contact:
Email: fccletaylor@gmail.com
Phone: +250 731 017 472

Summary:
Passionate Web Developer building modern and responsive web applications.

Skills:
- Frontend: React.js, HTML/CSS, Tailwind
- Backend: Node.js, Express.js
- Database: PostgreSQL, MongoDB
- Other: API Development, Git

Experience:
- Web Developer (Personal Projects)
- Volunteer Developer

Education:
- University of Lagos Graduate
- IT since 11th grade
  `;

  const blob = new Blob([cvContent], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'Fidela_CV.txt';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
};